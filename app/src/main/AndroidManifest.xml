<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Фоновая запись тренировки (C1): микрофон + foreground-сервис типа microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Фоновая заливка записи (C3): long-running foreground-воркер WorkManager типа dataSync. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Показ уведомления записи/заливки на Android 13+ (рантайм-разрешение). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- A3 (#97): видеозапись тренировки (штатив) через CameraX. Камера не обязательна
         для установки приложения (аудио-режим работает и без неё) — required="false". -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".NivelApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nivel">

        <!-- #106: configChanges на orientation|screenSize|... не даёт системе пересоздавать
             Activity при повороте — иначе CameraX (привязан к LifecycleOwner Activity, см.
             VideoRecorder.bind) отвязывается на пересоздании и финализирует видеозапись
             тренировки как при сворачивании. Single-Activity + Compose: recreate тут не
             несёт полезной нагрузки (весь стейт — в rememberSaveable/ViewModel/process-wide
             RecordingController), Compose и так корректно перекомпонует layout на новую
             Configuration без ручного onConfigurationChanged. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Nivel.Splash"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link возврата из Chrome Custom Tabs после входа через Гречку:
                 nivel://auth/callback?token=<firebaseIdToken>&state=<csrf[~claim]>.
                 Заменяет перехват редиректа в WebView (Google блокирует OAuth в WebView:
                 disallowed_useragent / Error 403). singleTask + onNewIntent доставляют
                 callback в уже запущенную Activity. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="nivel"
                    android:host="auth"
                    android:path="/callback" />
            </intent-filter>

            <!-- #81: App Link ссылки-приглашения ученика (claimUrl из
                 POST /api/v1/students — `${NIVEL_URL}/invite/{token}`, веб-роут
                 src/app/invite/[token]/page.tsx). autoVerify=true запрошено, но
                 реально сработает только после публикации /.well-known/assetlinks.json
                 на домене (репо NIVEL) с отпечатком RELEASE-подписи — её в этом
                 репозитории пока нет (`./gradlew signingReport` не даёт release-ключ,
                 см. app/build.gradle.kts). До assetlinks.json ссылка на реальном
                 устройстве (тап в WhatsApp/SMS) вероятно уйдёт в браузер, а не в
                 приложение — Android не верифицирует домен без него. Проверять этот
                 intent-filter нужно ЯВНЫМ intent'ом (`adb shell am start -n
                 com.nivel.trainer/.MainActivity -a android.intent.action.VIEW -d
                 "https://…/invite/<token>"`), а не implicit `-a VIEW -d <url>` без
                 `-n` — implicit версия на реальном устройстве с браузером по
                 умолчанию тоже, скорее всего, откроет браузер. Остальные пути домена
                 intent-filter не ловит — уходят в браузер, как и требует acceptance. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${nivelHost}"
                    android:pathPrefix="/invite" />
            </intent-filter>
        </activity>

        <!-- Foreground-сервис фоновой записи тренировки (C1). Не экспортируется —
             управляется только изнутри приложения через RecordingController. -->
        <service
            android:name=".service.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- C3 (#12): long-running foreground-воркер заливки на Android 14+ требует
             объявить тип foreground-сервиса WorkManager как dataSync. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- G2 (#31): сервис приёма FCM push-уведомлений. Не экспортируется —
             вызывается системой через MESSAGING_EVENT. -->
        <service
            android:name=".push.NivelFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- G2 (#31): дефолтные иконка и канал для уведомлений, которые система
             рисует сама из notification-блока пуша, когда приложение в фоне. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_launcher_monochrome" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="nivel_push" />

        <!-- C3 (#12): отключаем дефолтную инициализацию WorkManager через App Startup,
             чтобы поднять его on-demand с HiltWorkerFactory (см. NivelApp). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
